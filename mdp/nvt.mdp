define      = -DPOSRES
integrator  = md
nsteps      = 5000
dt          = 0.002
continuation = no
constraint_algorithm = lincs
constraints = h-bonds
cutoff-scheme = Verlet
coulombtype = PME
rcoulomb    = 1.0
rvdw        = 1.0
tcoupl      = V-rescale
tc-grps     = Protein_CURC  Water_and_ions
tau_t       = 0.1        0.1
ref_t       = 300        300
pcoupl      = no
pbc         = xyz
DispCorr    = EnerPres
gen_vel     = yes
gen_temp    = 300
gen_seed    = -1
nstxout     = 500
nstvout     = 500
nstenergy   = 500
nstlog      = 500
